{
  "name": "animated-shorts-kit",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "still": "remotion still src/index.ts Preview out/still.png --frame=60",
    "preview": "remotion render src/index.ts Preview out/preview_lite.mp4",
    "gates": "tsx --tsconfig src/videos/02_pachinko/tsconfig.json src/engine/check/gates.ts",
    "still:full": "REMOTION_LOOK=full remotion still src/index.ts Preview out/still_full.png --frame=60",
    "preview:full": "REMOTION_LOOK=full remotion render src/index.ts Preview out/preview_full.mp4"
  },
  "dependencies": {
    "@fontsource/archivo-black": "^5.3.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "@remotion/cli": "^4.0.545",
    "@remotion/three": "^4.0.545",
    "postprocessing": "^6.39.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.545",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2"
  }
}